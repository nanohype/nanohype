# ──── LLM Provider ────
# Provider: gateway, or off the substrate anthropic | openai
LLM_PROVIDER=__LLM_PROVIDER__
# The model the anthropic and openai providers call. The gateway provider
# names a route instead (MODEL_ROUTE below).
LLM_MODEL=claude-sonnet-5
# Unset or empty configures none. The openai provider sends it, and 0.1 when
# none is configured. The gateway and anthropic providers never send one: the
# Messages API rejects sampling parameters.
# LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# How long the analysis providers wait on a model call, in ms: a whole number
# from 1 to 2147483647, 120000 when unset or empty. A call has to finish its
# reply within it, so raising LLM_MAX_TOKENS raises this with it. The gateway
# provider gives up on a call at one timeout; the anthropic and openai SDK
# clients give each attempt the full timeout and retry a timed-out attempt
# once. The whisper transcription client runs under its SDK's own timeout.
LLM_REQUEST_TIMEOUT_MS=120000

# ──── Platform ModelGateway (gateway provider) ────
# On the nanohype substrate every model call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the pipeline holds no model
# credential and sends none. The gateway root, as ModelGateway status.endpoint
# publishes it; unset, the Service the operator creates for the Platform this
# project deploys under.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The route a request names. The ModelGateway CR maps each route to a Bedrock
# model.
# MODEL_ROUTE=default
# #if IncludeKeyProviders || IncludeAudio

# ──── Provider API keys (off the substrate only) ────
# The anthropic and openai providers and whisper transcription authenticate
# with a provider key. The LLM policy permits one only off the substrate (a
# CLI, a desktop app, a local tool), only for a provider the intake brief
# names, read from the environment or the OS keychain and never committed.
# #endif
# #if IncludeKeyProviders
# ANTHROPIC_API_KEY=
# #endif
# #if IncludeKeyProviders || IncludeAudio
# OPENAI_API_KEY=
# #endif

# ──── Image Processing ────
IMAGE_MAX_DIMENSION=2048
IMAGE_DETAIL=high

# ──── Audio Processing ────
AUDIO_TRANSCRIPTION_MODEL=whisper-1
AUDIO_MAX_DURATION_SECONDS=600

# ──── Video Processing ────
VIDEO_FRAME_INTERVAL_SECONDS=2
VIDEO_MAX_FRAMES=30

# ──── Output ────
OUTPUT_FORMAT=json
LOG_LEVEL=info
