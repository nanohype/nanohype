# ──── LLM Provider ────
# Provider: gateway on the nanohype substrate, bedrock off it
LLM_PROVIDER=__LLM_PROVIDER__
# The inference-profile ID the bedrock provider calls. The gateway provider
# names a route instead (MODEL_ROUTE below).
LLM_MODEL=us.anthropic.claude-sonnet-5
# Unset or empty configures none. The bedrock provider sends it to a model of
# a family other than Claude; neither provider sends one to Claude.
# LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# How long the analysis providers wait on a model call, in ms: a whole number
# from 1 to 2147483647, 120000 when unset or empty. A call has to finish its
# reply within it, so raising LLM_MAX_TOKENS raises this with it. Both
# providers give up on a call, retries included, at one timeout.
LLM_REQUEST_TIMEOUT_MS=120000

# ──── Platform ModelGateway (gateway provider) ────
# On the nanohype substrate every model call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the pipeline holds no model
# credential and sends none. The gateway root, as ModelGateway status.endpoint
# publishes it; unset, the Service the operator creates for the Platform this
# project deploys under.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The route a request names. The ModelGateway CR maps each route to a Bedrock
# model.
# MODEL_ROUTE=default

# ──── AWS (bedrock provider and audio transcription, off the substrate) ────
# Both run under the IAM role the AWS SDK's default credential chain
# resolves: a task or execution role in AWS, an AWS profile on a
# workstation. No provider key.
# AWS_REGION=us-east-1

# ──── Image Processing ────
IMAGE_MAX_DIMENSION=2048
IMAGE_DETAIL=high

# ──── Audio Processing ────
# #if IncludeAudio
# The s3://bucket/prefix Amazon Transcribe reads staged audio from and writes
# its transcript to. The role needs s3:PutObject, s3:GetObject and
# s3:DeleteObject under it, and transcribe:StartTranscriptionJob,
# transcribe:GetTranscriptionJob and transcribe:DeleteTranscriptionJob. Give
# the prefix an S3 lifecycle rule that expires its objects.
TRANSCRIBE_S3_URI=
# The language the audio is in, such as en-US; empty lets Transcribe
# identify it.
AUDIO_LANGUAGE_CODE=
# How long a transcription may run, in ms: a whole number from 1 to
# 2147483647, 900000 when unset or empty. A job still running then is
# followed for as long again, and its transcript deleted once it settles.
AUDIO_TRANSCRIPTION_TIMEOUT_MS=900000
# #endif
AUDIO_MAX_DURATION_SECONDS=600

# ──── Video Processing ────
VIDEO_FRAME_INTERVAL_SECONDS=2
VIDEO_MAX_FRAMES=30

# ──── Output ────
OUTPUT_FORMAT=json
LOG_LEVEL=info
