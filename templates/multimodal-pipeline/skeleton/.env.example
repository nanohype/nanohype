# ──── LLM Provider ────
# Provider: anthropic | openai
LLM_PROVIDER=__LLM_PROVIDER__
LLM_MODEL=claude-sonnet-5
# Unset or empty configures none. The openai provider sends it, and 0.1 when
# none is configured. The anthropic provider never sends one: the Messages API
# rejects sampling parameters.
# LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
# How long the anthropic and openai providers wait on a model call, in ms: a
# whole number from 1 to 2147483647, 120000 when unset or empty. A call has to
# finish its reply within it, so raising LLM_MAX_TOKENS raises this with it.
# Each SDK client gives each attempt the full timeout and retries a timed-out
# attempt once. The whisper transcription client runs under its SDK's own
# timeout.
LLM_REQUEST_TIMEOUT_MS=120000

# Anthropic API key (required for anthropic provider)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# OpenAI API key (required for openai provider)
OPENAI_API_KEY=sk-your-openai-api-key

# ──── Image Processing ────
IMAGE_MAX_DIMENSION=2048
IMAGE_DETAIL=high

# ──── Audio Processing ────
AUDIO_TRANSCRIPTION_MODEL=whisper-1
AUDIO_MAX_DURATION_SECONDS=600

# ──── Video Processing ────
VIDEO_FRAME_INTERVAL_SECONDS=2
VIDEO_MAX_FRAMES=30

# ──── Output ────
OUTPUT_FORMAT=json
LOG_LEVEL=info
