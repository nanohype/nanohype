# ──── LLM + Embeddings (Platform ModelGateway — default) ────
# On the nanohype substrate every model call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the pipeline holds no model
# credential and sends none. The gateway root, as ModelGateway status.endpoint
# publishes it; unset, the Service the operator creates for the Platform this
# project deploys under.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The routes generation and embedding requests name. The ModelGateway CR maps
# each route to a Bedrock model.
# MODEL_ROUTE=default
# EMBEDDING_ROUTE=embeddings
# How long the LLM and embedding providers wait on a model call, in ms: a
# whole number from 1 to 2147483647, 120000 when unset or empty, and any other
# value fails the configuration as it loads. A call has to finish its reply
# within it, so raising LLM_MAX_TOKENS past 4096 raises this with it. The
# gateway and bedrock providers give up on the whole call at it.
LLM_REQUEST_TIMEOUT_MS=120000

# ──── AWS Bedrock, called directly (bedrock provider) ────
# Authenticates via the AWS credential chain — no API keys — so it serves a
# pipeline off the substrate: an ECS task role, or a local AWS profile in dev.
# On the substrate use the gateway providers: a direct call skips the route's
# guardrail and rate limit. Set the region where the models are enabled.
AWS_REGION=us-east-1

# ──── Generation (LLM) ────
# Provider: gateway (default) | bedrock, off the substrate
LLM_PROVIDER=__LLM_PROVIDER__
# The inference-profile ID the bedrock provider calls. The gateway provider
# names MODEL_ROUTE instead.
LLM_MODEL=us.anthropic.claude-sonnet-5
# Unset or empty configures none. The gateway provider never sends one: the
# Messages API rejects sampling parameters. Under
# BEDROCK_SAMPLING_PARAMETERS=auto, the bedrock provider sends it to a model
# id that names a family other than Claude, and to none that is Claude or
# names no family (an application inference profile ARN, for example); with
# none configured it sends none to any model.
# LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
# Overrides which bedrock requests carry LLM_TEMPERATURE: auto (the rule
# above), send (every model id) or omit (none). Unset or empty is auto, and
# any other value fails the configuration as it loads.
# BEDROCK_SAMPLING_PARAMETERS=auto

# ──── Embedding Provider ────
# Provider: gateway (default) | bedrock (Titan v2), off the substrate. The
# gateway provider names EMBEDDING_ROUTE instead of EMBEDDING_MODEL and asks
# the route for EMBEDDING_DIMENSIONS.
EMBEDDING_PROVIDER=__EMBEDDING_PROVIDER__
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=128

# ──── Chunking ────
CHUNK_STRATEGY=__CHUNK_STRATEGY__
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ──── Vector Store ────
# Backend: chroma | pgvector | qdrant | pinecone. pgvector is the durable
# cluster default; chroma is convenient for local dev.
VECTORSTORE_BACKEND=__VECTOR_STORE__
VECTORSTORE_COLLECTION_NAME=documents
# Chroma's JS client talks to a running server (no embedded mode). For local dev:
#   docker run -p 8000:8000 chromadb/chroma
VECTORSTORE_CHROMA_URL=http://localhost:8000
# VECTORSTORE_PG_CONNECTION_STRING=postgresql://user:password@localhost:5432/__PROJECT_NAME__
# VECTORSTORE_QDRANT_URL=http://localhost:6333
# VECTORSTORE_QDRANT_API_KEY=
# VECTORSTORE_PINECONE_API_KEY=
# VECTORSTORE_PINECONE_INDEX_NAME=__PROJECT_NAME__

# ──── Retrieval ────
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0

# ──── Ingestion ────
DOCS_DIR=./docs
