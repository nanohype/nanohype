{
  "name": "__PROJECT_NAME__",
  "displayName": "__EXTENSION_NAME__",
  "description": "__DESCRIPTION__",
  "version": "0.1.0",
  "publisher": "__PUBLISHER__",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "__ACTIVATION_EVENT__"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "__PROJECT_NAME__.example",
        "title": "__EXTENSION_NAME__: Run Example Command"
      },
      {
        "command": "__PROJECT_NAME__.openWebview",
        "title": "__EXTENSION_NAME__: Open Webview Panel"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "publish": "vsce publish",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.0",
    "openai": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.96.0",
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
