{
  "name": "__PROJECT_NAME__",
  "displayName": "__EXTENSION_NAME__",
  "description": "__DESCRIPTION__",
  "version": "0.1.0",
  "publisher": "__PUBLISHER__",
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=26"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "__ACTIVATION_EVENT__"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "The provider, model and AWS settings take their values from user or remote settings, never from a workspace, so a workspace cannot choose which AWS profile signs a model call, which model it reaches or which region serves it.",
      "restrictedConfigurations": [
        "__PROJECT_NAME__.provider",
        "__PROJECT_NAME__.model",
        "__PROJECT_NAME__.awsProfile",
        "__PROJECT_NAME__.awsRegion"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "__PROJECT_NAME__.example",
        "title": "__EXTENSION_NAME__: Run Example Command"
      },
      {
        "command": "__PROJECT_NAME__.openWebview",
        "title": "__EXTENSION_NAME__: Open Webview Panel"
      }
    ],
    "configuration": {
      "title": "__EXTENSION_NAME__",
      "properties": {
        "__PROJECT_NAME__.provider": {
          "type": "string",
          "scope": "machine",
          "default": "bedrock",
          "description": "AI provider the webview chat sends turns to, when the webview and AI features are included. Any name the provider registry holds is accepted."
        },
        "__PROJECT_NAME__.model": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Model id the webview chat sends, when the webview and AI features are included: a Bedrock cross-region inference-profile ID for the bedrock provider. Empty uses the provider's default model."
        },
        "__PROJECT_NAME__.awsProfile": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "AWS profile the bedrock provider signs with, from the AWS config file. Empty uses the AWS SDK's default credential chain."
        },
        "__PROJECT_NAME__.awsRegion": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "AWS region the bedrock provider calls Bedrock in. Empty uses AWS_REGION, then us-east-1."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "publish": "vsce publish",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1030.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/vscode": "^1.125.0",
    "@vitest/coverage-v8": "^4.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
