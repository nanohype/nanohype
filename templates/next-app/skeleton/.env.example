# ── AI Provider ───────────────────────────────────────────────────────
# gateway (default) | anthropic | openai, the last two off the substrate
LLM_PROVIDER=__LLM_PROVIDER__

# ── Platform ModelGateway (gateway provider) ─────────────────────────
# On the nanohype substrate every model call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the app holds no model
# credential and sends none. The gateway root, as ModelGateway
# status.endpoint publishes it; unset, the Service the operator creates for
# the Platform this project deploys under. Running locally, point it at a
# port-forward of that Service.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The route every request names. The ModelGateway CR maps it to a Bedrock
# model.
# MODEL_ROUTE=default
# How long a call waits on the gateway, and a stream on its next event, in
# ms: a whole number from 1 to 2147483647, 120000 when unset or empty.
# LLM_REQUEST_TIMEOUT_MS=120000
# #if IncludeKeyProviders

# ── Provider API keys (off the substrate only) ───────────────────────
# The anthropic and openai providers authenticate with a provider key. The
# LLM policy permits one only off the substrate (a CLI, a desktop or browser
# app, a local tool), only for a provider the intake brief names, read from
# the environment or the OS keychain and never committed.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# #endif

# ── Database (optional) ──────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/__PROJECT_NAME__

# ── Auth (optional) ──────────────────────────────────────────────────
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# ── Application ──────────────────────────────────────────────────────
LOG_LEVEL=info
