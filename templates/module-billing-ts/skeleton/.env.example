# ── Billing Module ─────────────────────────────────────────────────────
# Variables the billing module reads. Enable the ones you need.

# ── Stripe ──────────────────────────────────────────────────────────
# A secret key (sk_...) or restricted key (rk_...); any other shape is refused.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Logging ─────────────────────────────────────────────────────────
# debug, info, warn, error, or silent. Unset or unrecognized, the level is info.
# LOG_LEVEL=info
