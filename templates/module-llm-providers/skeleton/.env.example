# ── LLM Providers Module ──────────────────────────────────────────────
# API keys for each provider. Only set the ones you use.

# ── Anthropic ───────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI ──────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Groq ────────────────────────────────────────────────────────────
# GROQ_API_KEY=gsk_...

# ── AWS Bedrock (conditional) ───────────────────────────────────────
# Authenticates through the AWS credential chain (IRSA in-cluster); no keys.
# Set only the region — credentials resolve from the pod's IAM role.
# AWS_REGION=us-east-1
# LLM_REQUEST_TIMEOUT_MS=30000
# Which requests carry the caller's temperature and topP: auto (a model id
# that names a family other than Claude), send (every model id) or omit
# (none). An ARN that names no family, such as an application inference
# profile, counts as Claude under auto.
# BEDROCK_SAMPLING_PARAMETERS=auto

# ── Google Vertex AI (conditional) ──────────────────────────────────
# Uses Application Default Credentials (ADC)
# GOOGLE_CLOUD_PROJECT=...
# GOOGLE_CLOUD_LOCATION=us-central1

# ── Hugging Face (conditional) ──────────────────────────────────────
# HF_TOKEN=hf_...

# ── Ollama (conditional) ────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
