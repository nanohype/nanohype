# ── LLM Providers Module ──────────────────────────────────────────────

# How long each provider except ollama waits on a model, in ms: a whole
# number from 1 to 2147483647, 120000 when unset or empty. A request that
# does not stream has to finish its reply within it, so a caller that
# raises maxTokens past the 4096 default raises this with it, or streams;
# a stream fails when no event arrives for that long.
# LLM_REQUEST_TIMEOUT_MS=120000

# ── Platform ModelGateway (gateway provider) ────────────────────────
# On the nanohype substrate every model call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the application holds no
# model credential and sends none. The gateway root, as ModelGateway
# status.endpoint publishes it; unset, the Service the operator creates
# for the Platform this project deploys under.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The route a request names when it sets no model. The ModelGateway CR
# maps each route to a Bedrock model.
# MODEL_ROUTE=default
# #if IncludeKeyProviders

# ── Provider API keys (off the substrate only) ──────────────────────
# The anthropic, openai and groq providers authenticate with a provider
# key. The LLM policy permits one only off the substrate (a CLI, a desktop
# app, a local tool), only for a provider the intake brief names, read
# from the environment or the OS keychain and never committed. Their
# clients give each attempt of a request the full timeout and retry a
# timed-out attempt once.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# #endif

# ── AWS Bedrock (conditional) ───────────────────────────────────────
# Calls Bedrock directly over the AWS credential chain, so it serves an
# application off the substrate: an ECS task role, or a local AWS profile.
# On the substrate the operator's egress policy leaves application pods no
# route to Bedrock; use the gateway provider there.
# AWS_REGION=us-east-1
# Which requests carry the caller's temperature and topP: auto (a model id
# that names a family other than Claude), send (every model id) or omit
# (none). An ARN that names no family, such as an application inference
# profile, counts as Claude under auto.
# BEDROCK_SAMPLING_PARAMETERS=auto

# ── Google Vertex AI (conditional) ──────────────────────────────────
# Authenticates through Application Default Credentials (ADC); a key in
# GOOGLE_API_KEY or GEMINI_API_KEY is ignored.
# GOOGLE_CLOUD_PROJECT=...
# GOOGLE_CLOUD_LOCATION=us-central1

# ── Hugging Face (conditional) ──────────────────────────────────────
# A provider token, which the LLM policy permits only off the substrate,
# for a provider the intake brief names, read from the environment or the
# OS keychain and never committed.
# HF_TOKEN=

# ── Ollama (conditional) ────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
# The request timeout for ollama, in ms, read as LLM_REQUEST_TIMEOUT_MS is:
# 600000 when unset or empty, sized for local inference on modest hardware.
# OLLAMA_REQUEST_TIMEOUT_MS=600000
