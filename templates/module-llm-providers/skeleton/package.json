{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "description": "__DESCRIPTION__",
  "type": "module",
  "main": "dist/llm-providers/index.js",
  "types": "dist/llm-providers/index.d.ts",
  "exports": {
    ".": "./dist/llm-providers/index.js",
    "./providers": "./dist/llm-providers/providers/index.js",
    "./adapters": "./dist/llm-providers/adapters/gateway.js",
    "./tokens": "./dist/llm-providers/tokens/counter.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --watch src/llm-providers/index.ts",
    "start": "node dist/llm-providers/index.js",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "npm audit --audit-level=high --omit=dev"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1030.0",
    "@opentelemetry/api": "^1.9.1",
    "js-tiktoken": "^1.0.18",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.21.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=26"
  }
}
