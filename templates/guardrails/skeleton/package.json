{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "description": "__DESCRIPTION__",
  "type": "module",
  "main": "dist/guardrails/index.js",
  "types": "dist/guardrails/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/guardrails/index.d.ts",
      "import": "./dist/guardrails/index.js"
    },
    "./filters": {
      "types": "./dist/guardrails/filters/index.d.ts",
      "import": "./dist/guardrails/filters/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
