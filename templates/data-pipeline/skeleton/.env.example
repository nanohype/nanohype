# ──── Embedding Provider (Platform ModelGateway — default) ────
# On the nanohype substrate every embedding call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the pipeline holds no model
# credential and sends none. The gateway root, as ModelGateway status.endpoint
# publishes it; unset, the Service the operator creates for the Platform this
# project deploys under.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The route embedding requests name. The ModelGateway CR maps it to a Bedrock
# model.
# EMBEDDING_ROUTE=embeddings
# How long an embedding call waits, in ms, for every provider.
EMBED_REQUEST_TIMEOUT_MS=30000

# Provider: gateway (default) | bedrock (Titan v2), or off the substrate
# openai. The gateway provider names EMBEDDING_ROUTE instead of
# EMBEDDING_MODEL and asks the route for EMBEDDING_DIMENSIONS.
EMBEDDING_PROVIDER=__EMBEDDING_PROVIDER__
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=128

# ──── AWS Bedrock, called directly (bedrock provider) ────
# Authenticates via the AWS credential chain — no API keys — so it serves a
# pipeline off the substrate: an ECS task role, or a local AWS profile in dev.
# On the substrate use the gateway provider: a direct call skips the route's
# guardrail and rate limit. Set the region where Titan is enabled.
AWS_REGION=us-east-1
# #if IncludeKeyProviders

# ──── Provider API keys (off the substrate only) ────
# The openai provider authenticates with a provider key, with
# EMBEDDING_MODEL=text-embedding-3-small and EMBEDDING_DIMENSIONS=1536. The
# LLM policy permits one only off the substrate (a CLI, a desktop app, a local
# tool), only for a provider the intake brief names, read from the environment
# or the OS keychain and never committed.
# OPENAI_API_KEY=
# #endif

# ──── Chunking ────
CHUNK_STRATEGY=__CHUNK_STRATEGY__
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ──── Output ────
# Adapter: json-file | console
OUTPUT_ADAPTER=json-file
OUTPUT_FILE=./output/embeddings.jsonl

# ──── Pipeline ────
LOG_LEVEL=info
