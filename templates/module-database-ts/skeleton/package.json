{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "description": "__DESCRIPTION__",
  "type": "module",
  "main": "dist/db/index.js",
  "types": "dist/db/index.d.ts",
  "exports": {
    ".": "./dist/db/index.js",
    "./schema": "./dist/db/schema.js",
    "./drivers": "./dist/db/drivers/index.js",
    "./migrate": "./dist/db/migrate.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/db/index.ts",
    "start": "node dist/db/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "better-sqlite3": "^13.0.0",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/better-sqlite3": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^4.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
