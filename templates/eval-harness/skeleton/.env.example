# ── Bedrock (bedrock provider, a run on a CI runner or a workstation) ─
# The bedrock provider calls Bedrock under the IAM role the run assumes and
# holds no long-lived credential: on a CI runner the eval workflow federates
# the job's GitHub OIDC token into the role the repository variable
# EVAL_ROLE_ARN names; on a workstation the AWS SDK's default chain reads the
# profile AWS_PROFILE selects. The model is a cross-region inference-profile
# ID.
# AWS_PROFILE=
# AWS_REGION=us-east-1
# LLM_MODEL=us.anthropic.claude-sonnet-5

# ── Platform ModelGateway (gateway provider, a run inside the cluster) ─
# On the nanohype substrate every model call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the application holds no
# model credential and sends none. The gateway root, as ModelGateway
# status.endpoint publishes it; unset, the Service the operator creates
# for the Platform this project deploys under.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The route a run grades. The ModelGateway CR maps each route to a Bedrock
# model.
# MODEL_ROUTE=default
# #if IncludeKeyProviders

# ── Provider API keys (anthropic and openai providers) ──────────────
# The anthropic and openai providers authenticate with a provider key. The
# LLM policy permits one only off the nanohype substrate and only for a
# provider the intake brief names: a repository secret on a CI runner, read
# from the environment or the OS keychain on a workstation, never committed.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# #endif

# ── Application ──────────────────────────────────────────────────────
# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info
