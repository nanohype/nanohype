# ── Provider API keys (a run outside the cluster) ───────────────────
# The anthropic and openai providers authenticate with a provider key. The
# LLM policy permits one only off the nanohype substrate (a CI runner, a
# workstation), only for a provider the intake brief names, read from the
# environment or the OS keychain and never committed.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Platform ModelGateway (gateway provider, a run inside the cluster) ─
# On the nanohype substrate every model call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the application holds no
# model credential and sends none. The gateway root, as ModelGateway
# status.endpoint publishes it; unset, the Service the operator creates
# for the Platform this project deploys under.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The route a run grades. The ModelGateway CR maps each route to a Bedrock
# model.
# MODEL_ROUTE=default

# ── Application ──────────────────────────────────────────────────────
# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info
