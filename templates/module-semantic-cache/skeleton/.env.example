# ── Semantic Cache Module ─────────────────────────────────────────────
# Provider-specific variables. Enable the ones matching your embedding backend.

# ── Platform ModelGateway Embeddings (default) ───────────────────────
# On the nanohype substrate every embedding call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the cache holds no model
# credential and sends none. The gateway root, as ModelGateway
# status.endpoint publishes it; unset, the Service the operator creates for
# the Platform this project deploys under.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The route embedding requests name. The ModelGateway CR maps it to a
# Bedrock model.
# EMBEDDING_ROUTE=embeddings

# ── Bedrock Embeddings, called directly ──────────────────────────────
# Auth is the AWS credential chain, never API keys, so it serves a cache off
# the substrate: an ECS task role, or a local AWS profile in dev. On the
# substrate use the gateway provider: a direct call skips the route's
# guardrail and rate limit.
# AWS_REGION=us-east-1
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ── Timeouts ─────────────────────────────────────────────────────────
# Per-call embedding request timeout in ms (default 30000)
# EMBED_REQUEST_TIMEOUT_MS=30000
