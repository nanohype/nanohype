{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "description": "__DESCRIPTION__",
  "type": "module",
  "main": "dist/orchestrator/index.js",
  "types": "dist/orchestrator/index.d.ts",
  "exports": {
    ".": "./dist/orchestrator/index.js",
    "./agents": "./dist/orchestrator/agents/index.js",
    "./providers": "./dist/orchestrator/providers/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx --watch src/orchestrator/index.ts",
    "start": "node dist/orchestrator/index.js",
    "eval": "tsx src/orchestrator/eval/runner.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@opentelemetry/api": "^1.9.0",
    "openai": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
