# ── LLM Gateway Module ──────────────────────────────────────────────

# How long each provider waits on a model, in ms: a whole number from 1 to
# 2147483647, 120000 when unset or empty. A call has to finish its reply
# within it, so a caller that raises maxTokens past the 4096 default raises
# this with it. gateway and bedrock give up on the whole call at it.
# LLM_REQUEST_TIMEOUT_MS=120000

# ── Platform ModelGateway (gateway provider, the default) ───────────
# On the nanohype substrate every model call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the application holds no
# model credential and sends none. The gateway root, as ModelGateway
# status.endpoint publishes it; unset, the Service the operator creates
# for the Platform this project deploys under.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The route a request names when it sets no model. The ModelGateway CR
# maps each route to a Bedrock model.
# MODEL_ROUTE=default

# ── AWS Bedrock ─────────────────────────────────────────────────────
# Calls Bedrock directly over the AWS credential chain, so it serves an
# application off the substrate: an ECS task role, or a local AWS profile.
# On the substrate the operator's egress policy leaves application pods no
# route to Bedrock; use the gateway provider there.
# AWS_REGION=us-east-1
# LLM_MODEL=us.anthropic.claude-sonnet-5
# Which requests carry the caller's temperature: auto (a model id that names
# a family other than Claude), send (every model id) or omit (none). An ARN
# that names no family, such as an application inference profile, counts as
# Claude under auto.
# BEDROCK_SAMPLING_PARAMETERS=auto
# #if IncludeKeyProviders

# ── Provider API keys (off the substrate only) ──────────────────────
# The anthropic, openai and groq providers authenticate with a provider
# key. The LLM policy permits one only off the substrate (a CLI, a desktop
# app, a local tool), only for a provider the intake brief names, read
# from the environment or the OS keychain and never committed. Their
# clients give each attempt the full timeout and retry a timed-out attempt
# once.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# #endif

# ── Bounds (optional) ───────────────────────────────────────────────
# Max in-memory cache entries before oldest/LRU eviction.
# GATEWAY_CACHE_MAX_ENTRIES=10000
# Max in-memory cost-log entries before oldest entries are dropped.
# GATEWAY_COST_MAX_ENTRIES=100000
