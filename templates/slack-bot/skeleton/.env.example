# ── Slack ──────────────────────────────────────────────────────────────
# Bot token (xoxb-...) — required for all API calls
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token (xapp-...) — required for Socket Mode
SLACK_APP_TOKEN=xapp-your-app-token

# Signing secret — required for HTTP mode request verification
SLACK_SIGNING_SECRET=your-signing-secret

# ── LLM ────────────────────────────────────────────────────────────────
LLM_PROVIDER=__LLM_PROVIDER__

# Per-call LLM request timeout in milliseconds
LLM_REQUEST_TIMEOUT_MS=30000

# ── Platform ModelGateway (gateway provider, the default) ───────────
# On the nanohype substrate every model call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the application holds no
# model credential and sends none. The gateway root, as ModelGateway
# status.endpoint publishes it; unset, the Service the operator creates
# for the Platform this project deploys under.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The route a request names. The ModelGateway CR maps each route to a
# Bedrock model.
# MODEL_ROUTE=default

# ── AWS Bedrock (bedrock provider, off the substrate) ───────────────
# Calls Bedrock directly over the AWS credential chain, so it serves the bot
# off the substrate: an ECS task role, or a local AWS profile. On the
# substrate the operator's egress policy leaves application pods no route
# to Bedrock; use the gateway provider there.
# AWS_REGION=us-east-1
# LLM_MODEL=us.anthropic.claude-sonnet-5
# #if IncludeKeyProviders

# ── Provider API keys (off the substrate only) ──────────────────────
# The anthropic and openai providers authenticate with a provider key. The LLM
# policy permits one only off the substrate (a CLI, a desktop app, a local
# tool), only for a provider the intake brief names, read from the
# environment or the OS keychain and never committed.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# #endif

# ── Application ──────────────────────────────────────────────────────
# Port for HTTP mode (ignored in Socket Mode)
PORT=3000

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Set to "true" for Socket Mode, "false" for HTTP
SOCKET_MODE=true
