# ── Training Provider ─────────────────────────────────────────────────
# The pipeline runs off the nanohype substrate (a workstation or a CI
# runner): the Platform ModelGateway serves inference, not training jobs.
# The bedrock provider calls Bedrock and S3 under the IAM role the AWS SDK's
# default credential chain resolves (the AWS profile or the CI job's
# federated role), so no model credential is set here.
TRAINING_PROVIDER=__PROVIDER__
AWS_REGION=us-east-1

# Service role Bedrock assumes to read the splits and write job output
TRAINING_ROLE_ARN=arn:aws:iam::123456789012:role/your-bedrock-customization-role

# S3 prefix the splits upload to and job output lands under
TRAINING_S3_URI=s3://your-training-bucket/__PROJECT_NAME__

# ── Dataset ──────────────────────────────────────────────────────────
# Path to raw training data (JSONL with system/user/assistant messages)
DATA_INPUT_PATH=./data/examples/raw.jsonl

# Output directory for prepared dataset splits
DATA_OUTPUT_DIR=./data/prepared

# Train/validation/test split ratios (must sum to 1.0)
SPLIT_TRAIN_RATIO=0.8
SPLIT_VAL_RATIO=0.1
SPLIT_TEST_RATIO=0.1

# ── Training ─────────────────────────────────────────────────────────
# Base model to fine-tune, as Bedrock's customization identifier
BASE_MODEL=amazon.nova-micro-v1:0:128k

# Number of training epochs (leave empty for provider auto)
# TRAINING_EPOCHS=3

# Learning rate (leave empty for provider auto)
# LEARNING_RATE=0.00001

# Batch size, for a base model that takes one (leave empty for provider auto)
# BATCH_SIZE=1

# Training job suffix (appended to fine-tuned model name)
TRAINING_SUFFIX=__PROJECT_NAME__

# ── Eval ─────────────────────────────────────────────────────────────
# Inference profile the eval invokes the base model through
EVAL_BASE_MODEL=us.amazon.nova-micro-v1:0

# ARN of the custom model deployment or Provisioned Throughput serving the
# fine-tuned model, for evaluation (set after training completes)
# FINE_TUNED_MODEL=arn:aws:bedrock:us-east-1:123456789012:custom-model-deployment/your-deployment

# ── Application ──────────────────────────────────────────────────────
LOG_LEVEL=info
