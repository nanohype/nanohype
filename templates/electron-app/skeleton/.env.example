# ── AI Provider ───────────────────────────────────────────────────────
# The main process reads these from the environment it starts in. The
# bedrock provider calls Bedrock under the AWS SDK's default credential
# chain, so no model credential is set here: sign in to the AWS profile the
# app runs under and select it with AWS_PROFILE.

# Provider the app calls (bedrock, or a provider registered in
# src/main/providers/)
LLM_PROVIDER=__LLM_PROVIDER__

# AWS profile and region the bedrock provider signs and calls in
# AWS_PROFILE=your-profile
AWS_REGION=us-east-1

# Cross-region inference-profile ID (defaults to us.anthropic.claude-sonnet-5)
# LLM_MODEL=us.anthropic.claude-sonnet-5
