# ── Bedrock (bedrock provider, a run on a CI runner or a workstation) ─
# The bedrock provider calls Bedrock under the credentials the AWS SDK's
# default chain resolves: on a CI runner, the session credentials of the role
# the repository variable EVAL_ROLE_ARN names, which the eval workflow
# federates the job's GitHub OIDC token into; on a workstation, the profile
# AWS_PROFILE selects. Make that profile an IAM Identity Center sign-in or an
# assumed role (role_arn): the provider signs with whatever it resolves, and
# a profile holding an access key of its own signs with that long-lived key.
# The model is a cross-region inference-profile ID.
# AWS_PROFILE=
# AWS_REGION=us-east-1
# LLM_MODEL=us.anthropic.claude-sonnet-5

# ── Platform ModelGateway (gateway provider, a run inside the cluster) ─
# On the nanohype substrate every model call goes to the Platform's
# ModelGateway, which holds the Bedrock role; the application holds no
# model credential and sends none. The gateway root, as ModelGateway
# status.endpoint publishes it; unset, the Service the operator creates
# for the Platform this project deploys under.
# MODEL_GATEWAY_ENDPOINT=http://__PLATFORM_NAME__-gateway.tenants-__PLATFORM_NAME__.svc.cluster.local:8080
# The route a run grades. The ModelGateway CR maps each route to a Bedrock
# model.
# MODEL_ROUTE=default

# ── Eval Config ──────────────────────────────────────────────────────
# Directory containing YAML eval suite files
EVAL_PATH=__EVAL_PATH__
# Maximum allowed score regression (0.0–1.0)
REGRESSION_THRESHOLD=__REGRESSION_THRESHOLD__
# The registered provider a run calls; the scaffolded one when unset
LLM_PROVIDER=__LLM_PROVIDER__
# Path to baseline JSON file
BASELINE_PATH=.eval-baseline.json

# ── Application ──────────────────────────────────────────────────────
# Log level (debug, info, warn, error)
LOG_LEVEL=info
