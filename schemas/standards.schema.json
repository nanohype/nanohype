{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanohype.dev/schemas/standards.schema.json",
  "title": "nanohype Standards Manifest",
  "description": "Validates a single standards file under nanohype/standards/. Each file declares its kind, version, and a content payload whose shape depends on the kind.",
  "type": "object",
  "required": ["kind", "version", "title", "summary", "content"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "nanohype/standards/language-toolchain",
        "nanohype/standards/version-currency",
        "nanohype/standards/platform-tenant-contract",
        "nanohype/standards/llm-policy",
        "nanohype/standards/quality-rubric-dimensions",
        "nanohype/standards/testing-rubric",
        "nanohype/standards/resource-tagging",
        "nanohype/standards/resource-naming",
        "nanohype/standards/observability-slo",
        "nanohype/standards/telemetry-pipeline",
        "nanohype/standards/seo-baseline",
        "nanohype/standards/documentation-voice"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "description": "Major version of this standard. Bump on any breaking shape change. Agents should pin to the version range they were built for."
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "summary": {
      "type": "string",
      "minLength": 20,
      "description": "One-paragraph description suitable for an agent's tool-result text. Should answer 'what is this and when do I read it?'."
    },
    "content": {
      "type": "object",
      "description": "Payload whose shape depends on kind. See per-kind definitions below."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/language-toolchain"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["phases", "toolchains"],
            "properties": {
              "phases": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string" },
                "description": "The keys of each toolchain entry that hold a runnable command, in the order a repository runs them. A consumer dispatching phases reads this rather than carrying its own list, so a phase published here reaches every consumer and one retired here leaves them all. The remaining keys — manifest, lockfile, registry, versionLookup — identify the language rather than acting on it."
              },
              "toolchains": {
                "type": "object",
                "propertyNames": {
                  "enum": ["typescript", "go", "python", "rust", "java", "kotlin", "csharp"]
                },
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "install",
                    "build",
                    "lint",
                    "test",
                    "docs",
                    "lockfile",
                    "manifest",
                    "registry",
                    "versionLookup"
                  ],
                  "properties": {
                    "install": {
                      "type": "string"
                    },
                    "build": {
                      "type": "string"
                    },
                    "lint": {
                      "type": "string"
                    },
                    "test": {
                      "type": "string"
                    },
                    "docs": {
                      "type": "string"
                    },
                    "typecheck": {
                      "type": "string"
                    },
                    "lockfile": {
                      "type": "string"
                    },
                    "manifest": {
                      "type": "string"
                    },
                    "registry": {
                      "type": "string"
                    },
                    "versionLookup": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/version-currency"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["rules", "registries", "accepted_pin_reasons"],
            "properties": {
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "summary"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string",
                      "enum": ["reject", "warn"]
                    }
                  }
                }
              },
              "registries": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "accepted_pin_reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/platform-tenant-contract"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "required_artifacts",
              "platform_cr_shape",
              "otel_resource_attrs",
              "do_not"
            ],
            "properties": {
              "required_artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "description"],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "platform_cr_shape": {
                "type": "object"
              },
              "otel_resource_attrs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "required", "description"],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "do_not": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/llm-policy"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "primary_provider",
              "models",
              "regions_preferred",
              "sdk_by_language",
              "requirements"
            ],
            "properties": {
              "primary_provider": {
                "type": "string"
              },
              "models": {
                "type": "object",
                "required": ["default", "escalation", "light"],
                "properties": {
                  "default": {
                    "type": "string"
                  },
                  "escalation": {
                    "type": "string"
                  },
                  "light": {
                    "type": "string"
                  }
                }
              },
              "regions_preferred": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sdk_by_language": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "requirements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "summary"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "summary": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/quality-rubric-dimensions"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["dimensions"],
            "properties": {
              "dimensions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "name", "summary"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "name": {
                      "type": "string"
                    },
                    "summary": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/testing-rubric"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["shape", "coverage_floor", "rules"],
            "properties": {
              "shape": {
                "type": "string"
              },
              "coverage_floor": {
                "type": "object",
                "required": ["branches", "lines", "functions", "statements"],
                "properties": {
                  "branches": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "lines": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "functions": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "statements": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "summary"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string",
                      "enum": ["reject", "warn"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/resource-tagging"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["transforms", "reserved_prefixes", "dimensions", "required_by_surface"],
            "properties": {
              "transforms": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "reserved_prefixes": {
                "type": "object",
                "required": ["k8s", "otel", "app_extension"],
                "properties": {
                  "k8s": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "otel": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "app_extension": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              },
              "dimensions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "tier", "meaning", "render"],
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "tier": {
                      "type": "string",
                      "enum": ["required", "recommended", "contextual"]
                    },
                    "meaning": {
                      "type": "string"
                    },
                    "render": {
                      "type": "object",
                      "required": ["aws", "k8s", "otel"],
                      "additionalProperties": false,
                      "properties": {
                        "aws": {
                          "type": ["string", "null"]
                        },
                        "k8s": {
                          "type": ["string", "null"]
                        },
                        "otel": {
                          "type": ["string", "null"]
                        }
                      }
                    }
                  }
                }
              },
              "required_by_surface": {
                "type": "object",
                "required": ["aws", "k8s", "otel"],
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "conditional_requirements": {
                "type": "array",
                "description": "Tags required only on certain resource kinds, not universally.",
                "items": {
                  "type": "object",
                  "required": [
                    "dimension",
                    "surface",
                    "tag",
                    "required_on_kinds",
                    "value",
                    "rationale"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "dimension": {
                      "type": "string"
                    },
                    "surface": {
                      "type": "string",
                      "enum": ["aws", "k8s", "otel"]
                    },
                    "tag": {
                      "type": "string"
                    },
                    "required_on_kinds": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "value": {
                      "type": "string"
                    },
                    "rationale": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/resource-naming"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "environments",
              "domains",
              "cluster_identity",
              "transforms",
              "limits",
              "rules"
            ],
            "properties": {
              "environments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "domains": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "applies_to", "rule"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "applies_to": {
                      "type": "string"
                    },
                    "rule": {
                      "type": "string"
                    },
                    "example": {
                      "type": "string"
                    }
                  }
                }
              },
              "cluster_identity": {
                "type": "object",
                "required": ["tuple", "aws_cluster_name", "cluster_name_rules"],
                "properties": {
                  "tuple": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "aws_cluster_name": {
                    "type": "string"
                  },
                  "cluster_name_rules": {
                    "type": "string"
                  },
                  "shared_per_environment": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "per_cluster": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "transforms": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "limits": {
                "type": "object",
                "required": ["s3_bucket", "iam_role"],
                "properties": {
                  "s3_bucket": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "iam_role": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "note": {
                    "type": "string"
                  }
                }
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "summary"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string",
                      "enum": ["reject", "warn"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/observability-slo"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["principles", "slo", "burn_rate_alerts", "dashboard_requirements"],
            "properties": {
              "principles": {
                "type": "object",
                "required": ["red", "use", "golden_signals"],
                "properties": {
                  "red": {
                    "type": "string"
                  },
                  "use": {
                    "type": "string"
                  },
                  "golden_signals": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "domain_semantics": {
                    "type": "string"
                  },
                  "instrumentation": {
                    "type": "string"
                  }
                }
              },
              "slo": {
                "type": "object",
                "required": ["definition", "window_days", "sli_types", "error_budget"],
                "properties": {
                  "definition": {
                    "type": "string"
                  },
                  "window_days": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sli_types": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["id", "good_over_valid", "default_objective"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "good_over_valid": {
                          "type": "string"
                        },
                        "default_objective": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "exclusiveMaximum": 1
                        },
                        "default_threshold_seconds": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      }
                    }
                  },
                  "error_budget": {
                    "type": "string"
                  }
                }
              },
              "burn_rate_alerts": {
                "type": "object",
                "required": ["method", "windows"],
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "burn_rate_definition": {
                    "type": "string"
                  },
                  "windows": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["severity", "long", "short", "factor"],
                      "properties": {
                        "severity": {
                          "type": "string",
                          "enum": ["page", "ticket"]
                        },
                        "long": {
                          "type": "string"
                        },
                        "short": {
                          "type": "string"
                        },
                        "factor": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "budget_consumed": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "recording_rules": {
                "type": "object"
              },
              "fleet_alerting": {
                "type": "object",
                "required": [
                  "summary",
                  "severity_tiers",
                  "standard_dimensions",
                  "composite_rollup"
                ],
                "properties": {
                  "summary": {
                    "type": "string"
                  },
                  "severity_tiers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["id", "intent"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "enum": ["critical", "warning", "info"]
                        },
                        "intent": {
                          "type": "string",
                          "enum": ["page", "ticket", "record"]
                        },
                        "topic_suffix": {
                          "type": "string"
                        },
                        "examples": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "standard_dimensions": {
                    "type": "object",
                    "required": ["required"],
                    "properties": {
                      "rationale": {
                        "type": "string"
                      },
                      "required": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      },
                      "conditional": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["tag", "when"],
                          "properties": {
                            "tag": {
                              "type": "string"
                            },
                            "when": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  },
                  "composite_rollup": {
                    "type": "object",
                    "required": ["rule"],
                    "properties": {
                      "rule": {
                        "type": "string"
                      },
                      "naming": {
                        "type": "string"
                      },
                      "recovery": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "dashboard_requirements": {
                "type": "object",
                "required": ["required_rows"],
                "properties": {
                  "required_rows": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["id", "panels"],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9_]*$"
                        },
                        "panels": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "conventions": {
                    "type": "object"
                  }
                }
              },
              "do": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "do_not": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/telemetry-pipeline"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": [
              "principles",
              "collection_contract",
              "tiers",
              "signal_contract",
              "discovery"
            ],
            "properties": {
              "principles": {
                "type": "object",
                "required": ["neutral_waist", "one_egress", "absent_is_not_healthy"],
                "properties": {
                  "neutral_waist": {
                    "type": "string"
                  },
                  "one_egress": {
                    "type": "string"
                  },
                  "absent_is_not_healthy": {
                    "type": "string"
                  },
                  "cost_is_a_design_input": {
                    "type": "string"
                  }
                }
              },
              "collection_contract": {
                "type": "object",
                "required": ["protocol", "endpoint", "topology", "workload_requirements"],
                "properties": {
                  "protocol": {
                    "type": "string",
                    "pattern": "OTLP",
                    "description": "Must name OTLP \u2014 the protocol IS the contract; a standard that admits another value is not describing this pipeline."
                  },
                  "endpoint": {
                    "type": "string",
                    "pattern": "^telemetry\\.",
                    "description": "Must begin with the collector-agnostic alias name. A standard that lets the endpoint be named for its implementation defeats the neutral waist it exists to define."
                  },
                  "endpoint_rationale": {
                    "type": "string"
                  },
                  "topology": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "required": ["tier", "shape", "owns"],
                      "properties": {
                        "tier": {
                          "enum": ["agent", "gateway"]
                        },
                        "shape": {
                          "enum": ["DaemonSet", "Deployment"]
                        },
                        "owns": {
                          "type": "string"
                        },
                        "never": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "node_scoping": {
                    "type": "string"
                  },
                  "workload_requirements": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "ingest": {
                    "type": "string"
                  }
                }
              },
              "tiers": {
                "type": "object",
                "required": ["rule", "invariant", "levels", "default"],
                "properties": {
                  "rule": {
                    "type": "string"
                  },
                  "invariant": {
                    "type": "string"
                  },
                  "levels": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "required": ["id", "intent", "metrics", "logs", "traces"],
                      "properties": {
                        "id": {
                          "enum": ["floor", "full"],
                          "description": "The tier vocabulary is closed \u2014 this standard defines it, so an unknown id means a document describing a different system."
                        },
                        "intent": {
                          "type": "string"
                        },
                        "metrics": {
                          "type": "string"
                        },
                        "logs": {
                          "type": "string"
                        },
                        "traces": {
                          "type": "string"
                        },
                        "requires": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "default": {
                    "enum": ["floor", "full"]
                  },
                  "unrouted_traces": {
                    "type": "string"
                  },
                  "default_rationale": {
                    "type": "string"
                  }
                }
              },
              "signal_contract": {
                "type": "object",
                "required": ["summary", "events", "rules"],
                "properties": {
                  "summary": {
                    "type": "string"
                  },
                  "events": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["detail_type", "source", "when", "detail_fields", "severity"],
                      "properties": {
                        "detail_type": {
                          "type": "string",
                          "pattern": "^[A-Z][A-Za-z0-9]*$",
                          "description": "PascalCase, matching the EventBridge detail-type on the wire."
                        },
                        "source": {
                          "type": "string",
                          "pattern": "^[a-z0-9.]+\\.nanohype\\.dev(/[a-z0-9-]+)?$",
                          "description": "An API-group-shaped source, so a reader can tell which control loop emitted it."
                        },
                        "when": {
                          "type": "string"
                        },
                        "detail_fields": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1
                        },
                        "severity": {
                          "type": "string",
                          "pattern": "critical|warning|info",
                          "description": "Must reference the observability-slo fleet_alerting tiers \u2014 that is what routes the event."
                        }
                      }
                    }
                  },
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                }
              },
              "discovery": {
                "type": "object",
                "required": ["summary", "prefix", "paths"],
                "properties": {
                  "summary": {
                    "type": "string"
                  },
                  "prefix": {
                    "type": "string",
                    "pattern": "^/",
                    "description": "An absolute parameter path."
                  },
                  "paths": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["path", "is"],
                      "properties": {
                        "path": {
                          "type": "string",
                          "pattern": "^[a-z0-9-]+/"
                        },
                        "is": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "absence_is_meaningful": {
                    "type": "string"
                  }
                }
              },
              "do": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "do_not": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/seo-baseline"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["canonical_host", "gsc", "required_files", "head_tags", "rules"],
            "properties": {
              "canonical_host": {
                "type": "object",
                "required": ["rule", "summary"],
                "properties": {
                  "rule": {
                    "type": "string",
                    "enum": ["apex", "www"]
                  },
                  "summary": {
                    "type": "string"
                  },
                  "redirect": {
                    "type": "string"
                  }
                }
              },
              "gsc": {
                "type": "object",
                "required": ["property_type", "verification", "summary"],
                "properties": {
                  "property_type": {
                    "type": "string",
                    "enum": ["url-prefix", "domain"]
                  },
                  "property": {
                    "type": "string"
                  },
                  "verification": {
                    "type": "string",
                    "enum": ["meta-tag", "dns-txt", "html-file"]
                  },
                  "summary": {
                    "type": "string"
                  }
                }
              },
              "required_files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["path", "description"],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "head_tags": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "required", "summary"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "summary": {
                      "type": "string"
                    }
                  }
                }
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "summary"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "summary": {
                      "type": "string"
                    },
                    "severity": {
                      "type": "string",
                      "enum": ["reject", "warn"]
                    }
                  }
                }
              },
              "implementation": {
                "type": "object"
              },
              "do": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "do_not": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "nanohype/standards/documentation-voice"
          }
        }
      },
      "then": {
        "properties": {
          "content": {
            "type": "object",
            "required": ["scope", "normative_references", "the_test", "rules", "method"],
            "properties": {
              "scope": {
                "type": "object",
                "required": ["applies_to"],
                "properties": {
                  "applies_to": {
                    "type": "string"
                  },
                  "excluded": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "normative_references": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "title", "resource", "adopted_for"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "title": {
                      "type": "string"
                    },
                    "resource": {
                      "type": "string"
                    },
                    "license": {
                      "type": "string"
                    },
                    "adopted_for": {
                      "type": "string"
                    }
                  }
                }
              },
              "the_test": {
                "type": "string"
              },
              "why_it_is_hard": {
                "type": "string"
              },
              "rules": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["id", "rule"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "rule": {
                      "type": "string"
                    },
                    "refines": {
                      "type": "string"
                    },
                    "origin": {
                      "type": "string"
                    },
                    "tell": {
                      "type": "string"
                    },
                    "test": {
                      "type": "string"
                    },
                    "rationale": {
                      "type": "string"
                    },
                    "correct": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "defect": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "conversions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "identifiers_as_operands": {
                      "type": "string"
                    },
                    "precedence": {
                      "type": "string"
                    },
                    "protected": {
                      "type": "string"
                    },
                    "hazard": {
                      "type": "string"
                    },
                    "worked_example": {
                      "type": "string"
                    },
                    "propagation": {
                      "type": "string"
                    },
                    "note": {
                      "type": "string"
                    },
                    "includes": {
                      "type": "string"
                    },
                    "runtime_state_exemption": {
                      "type": "string"
                    },
                    "most_common_shape": {
                      "type": "string"
                    }
                  }
                }
              },
              "method": {
                "type": "object",
                "required": ["summary"],
                "properties": {
                  "summary": {
                    "type": "string"
                  },
                  "hazards": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "enforceable": {
                    "type": "string"
                  },
                  "recommended_gate": {
                    "type": "string"
                  },
                  "who_audits": {
                    "type": "string"
                  },
                  "conformance_is_read": {
                    "type": "string"
                  },
                  "scope_of_precedence": {
                    "type": "string"
                  },
                  "relay_resolution": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
