{
  "name": "@nanohype/error-pages",
  "version": "0.1.0",
  "description": "Honest 404/500 pages for nanohype sites — a JS-free themed renderer plus a checker that verifies any error page is noindex, script-free and same-origin-styled.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "default": "./dist/vitest.js"
    }
  },
  "bin": {
    "nanohype-error-pages": "dist/bin/nanohype-error-pages.js"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@nanohype/tokens": "^0.2.0"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^25.8.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanohype/nanohype.git",
    "directory": "error-pages"
  },
  "homepage": "https://github.com/nanohype/nanohype/tree/main/error-pages#readme",
  "bugs": {
    "url": "https://github.com/nanohype/nanohype/issues"
  },
  "keywords": [
    "nanohype",
    "error-pages",
    "404",
    "500",
    "csp",
    "static-site"
  ]
}
